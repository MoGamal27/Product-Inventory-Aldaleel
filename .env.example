# =============================================
# Aldaleel Inventory — Environment Variables Template
# =============================================
# Copy this file to .env and fill in your values.
# NEVER put real credentials in this file.

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=aldaleel_inventory
DB_USERNAME=postgres
DB_PASSWORD=your_password_here

# Server
SERVER_PORT=8080

# JPA
JPA_DDL_AUTO=update
JPA_SHOW_SQL=true

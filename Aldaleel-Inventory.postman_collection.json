            "body": {
              "mode": "raw",
              "raw": "{\n  \"stockQuantity\": 100\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('Stock updated to 100', () => pm.expect(pm.response.json().stockQuantity).to.eql(100));"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "TASK-004 | Update Stock — Negative Value (400)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/products/{{productId}}/stock",
              "host": ["{{baseUrl}}"],
              "path": ["products", "{{productId}}", "stock"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"stockQuantity\": -5\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 400 Bad Request', () => pm.response.to.have.status(400));"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "TASK-002 | Delete Product",
          "request": {
            "method": "DELETE",
            "url": {
              "raw": "{{baseUrl}}/products/{{productId}}",
              "host": ["{{baseUrl}}"],
              "path": ["products", "{{productId}}"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 204 No Content', () => pm.response.to.have.status(204));"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    },
    {
      "name": "US-002 — Order Creation & Stock Reservation",
      "description": "TASK-005 to TASK-011: Create orders, validate stock, reserve stock, handle concurrency and rollback.",
      "item": [
        {
          "name": "TASK-005 | Create Order (reserve stock)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/orders",
              "host": ["{{baseUrl}}"],
              "path": ["orders"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"items\": [\n    {\n      \"productId\": {{productId}},\n      \"quantity\": 3\n    }\n  ]\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 201 Created', () => pm.response.to.have.status(201));",
                  "pm.test('Order status is PENDING', () => pm.expect(pm.response.json().status).to.eql('PENDING'));",
                  "pm.test('Order has items', () => pm.expect(pm.response.json().items.length).to.be.above(0));",
                  "pm.test('Total amount is calculated', () => pm.expect(pm.response.json().totalAmount).to.be.above(0));",
                  "const id = pm.response.json().id;",
                  "pm.collectionVariables.set('orderId', id);"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "TASK-005 | Create Order — Multiple Items",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/orders",
              "host": ["{{baseUrl}}"],
              "path": ["orders"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"items\": [\n    {\n      \"productId\": {{productId}},\n      \"quantity\": 2\n    }\n  ]\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 201 Created', () => pm.response.to.have.status(201));"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },

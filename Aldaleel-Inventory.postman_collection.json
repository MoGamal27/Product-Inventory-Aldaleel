{
  "info": {
    "name": "Aldaleel - Product Inventory & Stock Reservation",
    "description": "Complete API collection for the Aldaleel Product Inventory & Stock Reservation system.\n\nUS-001: Product Management\nUS-002: Order Creation & Stock Reservation\nUS-003: Order Cancellation & Stock Release",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080/api/v1",
      "type": "string"
    },
    {
      "key": "productId",
      "value": "1",
      "type": "string"
    },
    {
      "key": "orderId",
      "value": "1",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "US-001 — Product Management",
      "description": "TASK-001 to TASK-005: CRUD endpoints for products with stock management and pagination.",
      "item": [
        {
          "name": "TASK-002 | Create Product",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/products",
              "host": ["{{baseUrl}}"],
              "path": ["products"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Dell XPS 15 Laptop\",\n  \"description\": \"High-performance laptop with Intel Core i7\",\n  \"price\": 1200.00,\n  \"stockQuantity\": 50\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 201 Created', () => pm.response.to.have.status(201));",
                  "pm.test('Response has id', () => pm.expect(pm.response.json()).to.have.property('id'));",
                  "const id = pm.response.json().id;",
                  "pm.collectionVariables.set('productId', id);",
                  "pm.test('Stock quantity is 50', () => pm.expect(pm.response.json().stockQuantity).to.eql(50));"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "TASK-002 | Create Product — Validation Error (missing name)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/products",
              "host": ["{{baseUrl}}"],
              "path": ["products"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"description\": \"Missing name and price\",\n  \"stockQuantity\": 10\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 400 Bad Request', () => pm.response.to.have.status(400));",
                  "pm.test('Errors field exists', () => pm.expect(pm.response.json()).to.have.property('errors'));"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "TASK-002 | Create Product — Duplicate Name (409)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/products",
              "host": ["{{baseUrl}}"],
              "path": ["products"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Dell XPS 15 Laptop\",\n  \"description\": \"Duplicate product\",\n  \"price\": 999.00,\n  \"stockQuantity\": 5\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 409 Conflict', () => pm.response.to.have.status(409));"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "TASK-005 | Get All Products (Paginated)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/products?page=0&size=10&sort=name,asc",
              "host": ["{{baseUrl}}"],
              "path": ["products"],
              "query": [
                { "key": "page", "value": "0" },
                { "key": "size", "value": "10" },
                { "key": "sort", "value": "name,asc" }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('Response has content array', () => pm.expect(pm.response.json()).to.have.property('content'));",
                  "pm.test('Response has pagination info', () => {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body).to.have.property('totalElements');",
                  "  pm.expect(body).to.have.property('totalPages');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "TASK-002 | Get Product by ID",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/products/{{productId}}",
              "host": ["{{baseUrl}}"],
              "path": ["products", "{{productId}}"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('ID matches', () => pm.expect(pm.response.json().id).to.eql(parseInt(pm.collectionVariables.get('productId'))));"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "TASK-002 | Get Product by ID — Not Found (404)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/products/99999",

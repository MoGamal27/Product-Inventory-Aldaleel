    },
    {
      "name": "US-003 — Order Cancellation & Stock Release",
      "description": "TASK-012 to TASK-015: Cancel orders, restore stock, prevent double release, validate state transitions.",
      "item": [
        {
          "name": "TASK-012 | Cancel Order (restore stock)",
          "request": {
            "method": "PATCH",
            "url": {
              "raw": "{{baseUrl}}/orders/{{orderId}}/cancel",
              "host": ["{{baseUrl}}"],
              "path": ["orders", "{{orderId}}", "cancel"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('Order status is CANCELLED', () => pm.expect(pm.response.json().status).to.eql('CANCELLED'));"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "TASK-014 | Cancel Order Again — Double Release (422)",
          "request": {
            "method": "PATCH",
            "url": {
              "raw": "{{baseUrl}}/orders/{{orderId}}/cancel",
              "host": ["{{baseUrl}}"],
              "path": ["orders", "{{orderId}}", "cancel"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 422 Unprocessable Entity', () => pm.response.to.have.status(422));",
                  "pm.test('Error mentions already cancelled', () => pm.expect(pm.response.json().message.toLowerCase()).to.include('cancelled'));"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "TASK-015 | Cancel Non-Existent Order (404)",
          "request": {
            "method": "PATCH",
            "url": {
              "raw": "{{baseUrl}}/orders/99999/cancel",
              "host": ["{{baseUrl}}"],
              "path": ["orders", "99999", "cancel"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 404 Not Found', () => pm.response.to.have.status(404));"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    }

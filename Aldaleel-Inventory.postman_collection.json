                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "TASK-002 | Update Product",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/products/{{productId}}",
              "host": ["{{baseUrl}}"],
              "path": ["products", "{{productId}}"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Dell XPS 15 Laptop\",\n  \"description\": \"Updated — Intel Core i9, 32GB RAM\",\n  \"price\": 1500.00,\n  \"stockQuantity\": 50\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('Price updated', () => pm.expect(pm.response.json().price).to.eql(1500.00));"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "TASK-003 | Update Stock Only (PATCH)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/products/{{productId}}/stock",
              "host": ["{{baseUrl}}"],
              "path": ["products", "{{productId}}", "stock"]

              "path": ["orders"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"items\": [\n    {\n      \"productId\": {{productId}},\n      \"quantity\": 999999\n    }\n  ]\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 409 Conflict', () => pm.response.to.have.status(409));",
                  "pm.test('Error message mentions stock', () => pm.expect(pm.response.json().message.toLowerCase()).to.include('stock'));"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
